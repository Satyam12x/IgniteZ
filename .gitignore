# Allowlist: ignore everything at the top level, then track only what is needed to
# install, test and run Q Fleet. Anything else in the working folder stays local.
/*

!/.gitignore
!/.python-version
!/README.md
!/pyproject.toml
!/uv.lock
!/src/
!/tests/

# Scripts: only the pipeline that rebuilds the served model from the raw data.
!/scripts/
/scripts/*
!/scripts/build_panel.py
!/scripts/train_model.py

# Artifacts: the served model, and the two result files train_model.py reads
# (tuned hyperparameters, held-out accuracy for the model card).
!/artifacts/
/artifacts/*
!/artifacts/.gitkeep
!/artifacts/model/
!/artifacts/ablation_p13.json
!/artifacts/evaluation.json

# Data: the processed panel the model trains on (16 MB) is committed so a fresh clone
# runs without downloading. Raw EMSA workbooks come from
# `python -m greenfleet.data.mrv.download` into data/raw/.
!/data/
/data/*
!/data/raw/
/data/raw/*
!/data/raw/.gitkeep
!/data/interim/
/data/interim/*
!/data/interim/.gitkeep
!/data/interim/mrv_derived.parquet

# Generated files, anywhere in the tree
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
node_modules/
.env
.DS_Store
Thumbs.db
*.swp
~$*
